# systemd 单元模板。__NODE_BIN__ 与 __RUN_USER__ 由 deploy/install.sh 按目标机替换，
# 不要直接 cp 到 /etc/systemd/system/——请走 install.sh。
#
# 为什么 node 路径要可替换：生产机上 /usr/bin/node 可能被别的服务占着某个版本
# （这台就是，locxai-api 跑在 Node 20 上），而本服务需要 22+ 的 node:sqlite。
# 绝不能为了本服务去升系统 node，只能各用各的。

[Unit]
Description=红娘八字排盘 · 同步服务
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=/srv/hongniang-bazi
ExecStart=__NODE_BIN__ cloud/server.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
# 数据库放在独立目录，方便单独备份
Environment=DB_PATH=/srv/hongniang-bazi/data/hongniang-bazi.sqlite
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
