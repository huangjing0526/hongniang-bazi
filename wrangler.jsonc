{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hongniang-bazi",
  "main": "cloud/src/index.mjs",
  "compatibility_date": "2026-05-28",

  // paipan.locxai.com 已归自有服务器（47.76.95.3，nginx + Node，见 deploy/install.sh）。
  // 这里**不要**再绑该域名，否则一旦 locxai.com 的 NS 迁到 Cloudflare，
  // Worker 会把这个域名从 nginx 手里抢走。
  // 本 Worker 现在只作备用入口，走 workers.dev。
  "workers_dev": true,

  // 只发布 scripts/build.mjs 组装出来的 dist/。
  // docs/ 与 engine/test/ 永远不进 dist——本机 web/server.js 会把项目根目录整个暴露出去，
  // 线上不能重演这个问题。
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hongniang-bazi-db",
      "database_id": "e46890df-1f88-404b-9a95-714c27982738",
      "migrations_dir": "cloud/migrations"
    }
  ]
}
